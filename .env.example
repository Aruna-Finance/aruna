# Copy to .env (never committed). Every value here is optional.
# Testnet account that signs fixture and demo transactions. Its key stays in ~/.near-credentials.
ARUNA_TESTNET_ACCOUNT=
# Override public RPC endpoints (comma-separated, tried in order).
ARUNA_RPC_MAINNET=
ARUNA_RPC_TESTNET=
# Set to 1 to run tests that call public RPC.
ARUNA_LIVE=
# The indexer's block source (packages/indexer): a QuickNode testnet JSON-RPC endpoint. The URL carries
# its token, so it is a secret. Never logged.
QUICKNODE_RPC_URL=
# Used only when QUICKNODE_RPC_URL is empty: a FastNear key for testnet.neardata.xyz. Without either,
# neardata serves 30 blocks a minute, too slow for a backfill.
FASTNEAR_API_KEY=
# Where the indexer keeps its SQLite store.
ARUNA_INDEXER_DB=
