# Copy to .env (never committed). Every value here is optional.
# Testnet account that signs fixture and demo transactions. Its key stays in ~/.near-credentials.
ARUNA_TESTNET_ACCOUNT=
# Override public RPC endpoints (comma-separated, tried in order).
ARUNA_RPC_MAINNET=
ARUNA_RPC_TESTNET=
# Set to 1 to run tests that call public RPC.
ARUNA_LIVE=
# The indexer (packages/indexer): the Postgres database it keeps its state in, as the Supabase Session pooler URI.
# It carries the database password, so it is a secret. Never logged.
DATABASE_URL=
# Optional: a QuickNode testnet JSON-RPC endpoint, the archive for blocks older than dRPC keeps. The URL carries its
# token, so it is a secret. Never logged.
QUICKNODE_RPC_URL=
# Optional: a FastNear key for testnet.neardata.xyz, the backup behind QuickNode (the archive alone without a QuickNode
# URL). A secret, sent only as a Bearer header.
FASTNEAR_API_KEY=
# apps/web, read at BUILD time (a static export has no server): the base URL of a hosted @aruna/indexer, no
# trailing slash. Unset, the console's history panels say "History is not connected in this build".
NEXT_PUBLIC_INDEXER_URL=
# The attestor (packages/attestor) on a host with no ~/.near-credentials, such as a container. Both keys are secrets:
# set them on the host, never here. Unset, each falls back to its file (packages/attestor/README.md "Keys").
# The account key, ed25519:<base58>; prefer a function-call key limited to the registry's heartbeat and report_drift.
ARUNA_ATTESTOR_ACCOUNT_KEY=
# The report-signing seed, 64 hex characters: the seed_hex the registry has the public key of.
ARUNA_ATTESTOR_SIGNING_SEED_HEX=
# Where the attestor keeps its observations and nonce. On a container, a persistent volume.
ARUNA_ATTESTOR_STATE_DIR=
# The attestor follows the targets the registry assigns to it. The indexer's base URL lists them; the seed list
# (comma-separated) covers what a lagging indexer does not show yet. Each target is confirmed with the registry.
ARUNA_INDEXER_URL=
ARUNA_ATTESTOR_TARGETS=
# The attestor's account and the registry it reports to, for a host that passes no flags (a container).
ARUNA_ATTESTOR_ACCOUNT=
ARUNA_ATTESTOR_REGISTRY=
# The keeper (packages/keeper): acts as the registry owner after a drift report is final. The key is a secret: set it
# on the host, never here. Prefer a function-call key limited to the registry's set_class and lift_freeze.
ARUNA_KEEPER_ACCOUNT=
ARUNA_KEEPER_REGISTRY=
ARUNA_KEEPER_KEY=
# The seed list the keeper looks at besides the indexer's reports, comma-separated.
ARUNA_KEEPER_TARGETS=
