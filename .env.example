# Copy to .env (never committed). Every value here is optional.
# Testnet account that signs fixture and demo transactions. Its key stays in ~/.near-credentials.
ARUNA_TESTNET_ACCOUNT=
# Override public RPC endpoints (comma-separated, tried in order).
ARUNA_RPC_MAINNET=
ARUNA_RPC_TESTNET=
# Set to 1 to run tests that call public RPC.
ARUNA_LIVE=
# The indexer (packages/indexer): the Postgres database it keeps its state in, as the Supabase Session pooler URI.
# It carries the database password, so it is a secret. Never logged.
DATABASE_URL=
# Optional: a QuickNode testnet JSON-RPC endpoint, the archive for blocks older than dRPC keeps. The URL carries its
# token, so it is a secret. Never logged.
QUICKNODE_RPC_URL=
# Optional: a FastNear key for testnet.neardata.xyz, the backup behind QuickNode (the archive alone without a QuickNode
# URL). A secret, sent only as a Bearer header.
FASTNEAR_API_KEY=
# apps/web, read at BUILD time (a static export has no server): the base URL of a hosted @aruna/indexer, no
# trailing slash. Unset, the console's history panels say "History is not connected in this build".
NEXT_PUBLIC_INDEXER_URL=
