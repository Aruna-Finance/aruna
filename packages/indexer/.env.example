# Copy to .env (never committed). The CLI does not load it by itself:
#   node --env-file=.env packages/indexer/dist/cli.js serve        (Node 22 or later)
#   docker run --env-file .env ...
# Required: the Postgres database, as the Supabase Session pooler URI (Connect, then Session pooler, port 5432), in the
# same region as the service that runs the indexer. It carries the database password, so it is a secret. Never logged.
DATABASE_URL=
# The indexer needs no key to read the chain: it reads from dRPC and NEAR's archival RPC (config/testnet.json).
# Optional archive for blocks older than dRPC keeps: the FULL QuickNode testnet endpoint URL
# ("HTTP Provider" in the dashboard), https://<name>.<network>.quiknode.pro/<token>/ , not only the token.
# It carries the token, so it is a secret. 50 credits per block it reads.
QUICKNODE_RPC_URL=
# Optional: blocks read at once from QuickNode (default 3). Lower it to 2 if the log shows "HTTP 429".
QUICKNODE_CONCURRENCY=
# Optional: a FastNear key for testnet.neardata.xyz, which keeps every block. The backup that reads what QuickNode fails
# to serve, and the archive alone without a QuickNode URL. It is a secret, sent only as a Bearer header. Never logged.
FASTNEAR_API_KEY=
PORT=8080
