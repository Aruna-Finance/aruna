# Copy to .env (never committed). The CLI does not load it by itself:
#   node --env-file=.env packages/indexer/dist/cli.js serve        (Node 22 or later)
#   docker run --env-file .env ...
# The block source: the FULL QuickNode testnet endpoint URL ("HTTP Provider" in the dashboard),
# https://<name>.<network>.quiknode.pro/<token>/ , not only the token. It carries the token, so it is a secret.
QUICKNODE_RPC_URL=
# Used only when QUICKNODE_RPC_URL is empty: a FastNear key for testnet.neardata.xyz.
FASTNEAR_API_KEY=
ARUNA_INDEXER_DB=/data/aruna-indexer.sqlite
PORT=8080
