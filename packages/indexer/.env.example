# Copy to .env (never committed). Read by `aruna-indexer serve` and the container.
# The block source. A QuickNode testnet endpoint; the URL carries the token, so it is a secret.
QUICKNODE_RPC_URL=
# Used only when QUICKNODE_RPC_URL is empty: a FastNear key for testnet.neardata.xyz.
FASTNEAR_API_KEY=
ARUNA_INDEXER_DB=/data/aruna-indexer.sqlite
PORT=8080
