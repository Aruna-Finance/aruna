{
  "name": "@aruna/indexer",
  "version": "0.1.0",
  "description": "Aruna indexer: every aruna NEP-297 event on testnet, from the public block archive, served over a read-only HTTP API. Holds no keys.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "aruna-indexer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "postgres": "4.1.1"
  }
}
