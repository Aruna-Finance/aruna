{
  "name": "@aruna/mcp",
  "version": "0.1.0",
  "description": "MCP server for Aruna. Keyless tools any agent can call: can this NEAR contract still change under me?",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aruna-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aruna/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aruna/classifier-core": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
