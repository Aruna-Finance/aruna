{
  "name": "@aruna/sim",
  "version": "0.1.0",
  "description": "Pool solvency simulation: 200 agents over 60 days, five scenarios, the pool's own premium, adequacy, concentration and payout rules. Offline, seeded, deterministic. No runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "aruna-sim": "./dist/run.js"
  },
  "files": [
    "dist",
    "results"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sim": "tsc -p tsconfig.build.json && node dist/run.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aruna-Finance/aruna.git"
  },
  "homepage": "https://github.com/Aruna-Finance/aruna",
  "bugs": "https://github.com/Aruna-Finance/aruna/issues"
}
