{
  "name": "@aruna/sdk",
  "version": "0.1.0",
  "description": "Typed client for Aruna. v0 ships the keyless Classifier (can this NEAR contract still change?), a read-only vault view and the refusal reason codes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vault": {
      "types": "./dist/vault/index.d.ts",
      "import": "./dist/vault/index.js"
    },
    "./coverage": {
      "types": "./dist/coverage/index.d.ts",
      "import": "./dist/coverage/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "gen:types": "node ../../scripts/gen-abi-types.mjs",
    "check:types": "node ../../scripts/gen-abi-types.mjs --check"
  },
  "dependencies": {
    "@aruna/classifier-core": "workspace:*",
    "@aruna/rpc": "workspace:*",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aruna-Finance/aruna.git"
  },
  "homepage": "https://github.com/Aruna-Finance/aruna",
  "bugs": "https://github.com/Aruna-Finance/aruna/issues"
}
