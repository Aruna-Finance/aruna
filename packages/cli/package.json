{
  "name": "@aruna/cli",
  "version": "0.1.0",
  "description": "Aruna command line: classify NEAR accounts, run the mainnet measurement, list WASM imports (read-only), and migrate a testnet vault to the current version (signs).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aruna": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aruna/classifier-core": "workspace:*",
    "@aruna/rpc": "workspace:*",
    "@aruna/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
