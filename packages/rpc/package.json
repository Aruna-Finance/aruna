{
  "name": "@aruna/rpc",
  "version": "0.1.0",
  "description": "Browser-safe RpcReader for @aruna/classifier-core over public NEAR JSON-RPC, with endpoint fallback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aruna/classifier-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aruna-Finance/aruna.git"
  },
  "homepage": "https://github.com/Aruna-Finance/aruna",
  "bugs": "https://github.com/Aruna-Finance/aruna/issues"
}
